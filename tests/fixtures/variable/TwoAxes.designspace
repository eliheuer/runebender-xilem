<?xml version="1.0" encoding="UTF-8"?>
<designspace format="5.0">
  <axes>
    <axis name="Weight" tag="wght" minimum="100" default="400" maximum="900">
      <map input="100" output="0"/>
      <map input="400" output="40"/>
      <map input="900" output="100"/>
    </axis>
    <axis name="Width" tag="wdth" minimum="75" default="100" maximum="125"/>
  </axes>
  <sources>
    <source filename="Regular.ufo" stylename="Regular">
      <location><dimension name="Weight" xvalue="40"/><dimension name="Width" xvalue="100"/></location>
    </source>
    <source filename="Heavy.ufo" stylename="Heavy">
      <location><dimension name="Weight" uservalue="900"/></location>
    </source>
    <source filename="Wide.ufo" stylename="Wide">
      <location><dimension name="Width" uservalue="125"/></location>
    </source>
    <source filename="HeavyWide.ufo" stylename="Heavy Wide">
      <location><dimension name="Weight" xvalue="100"/><dimension name="Width" xvalue="125"/></location>
    </source>
    <source filename="Regular.ufo" layer="intermediate">
      <location><dimension name="Weight" xvalue="70"/></location>
    </source>
  </sources>
  <instances>
    <instance name="Medium" stylename="Medium">
      <location><dimension name="Weight" uservalue="650"/></location>
    </instance>
  </instances>
</designspace>
